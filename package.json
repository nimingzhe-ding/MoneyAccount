{
  "name": "money-account",
  "private": true,
  "version": "1.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-web-assets.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "android:sync": "node scripts/sync-version.mjs && npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
